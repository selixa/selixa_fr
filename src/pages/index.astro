---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { outils } from '../data/outils';

const projets = (await getCollection('projets', ({ data }) => !data.brouillon)).sort(
  (a, b) => a.data.ordre - b.data.ordre
);
---

<Base titre="selixa.fr — Alexis">
  <section class="section hero">
    <p class="eyebrow"><span class="sigil">~</span> whoami</p>
    <h1>Alexis, je construis des outils pour des gens qui gèrent des enfants.</h1>
    <p class="pitch">
      Fondateur solo de Koloni. Vingt saisons en direction d'accueils collectifs de
      mineurs, puis Apple Retail, puis customer success, puis j'ai appris à écrire du
      SQL. Aujourd'hui je fais les trois en même temps.
    </p>
    <ul class="tags">
      <li>Supabase</li>
      <li>PostgreSQL</li>
      <li>WeWeb</li>
      <li>Deno</li>
      <li>Cloudflare</li>
    </ul>
  </section>

  <section class="section" id="projets">
    <p class="eyebrow"><span class="sigil">~</span> ls projets/</p>
    <ul class="liste">
      {
        projets.map((p) => (
          <li class="projet">
            <div class="corps">
              <div class="titre-ligne">
                <a href={`/projets/${p.id}/`}>{p.data.titre}</a>
                {p.data.statut && <span class="badge">{p.data.statut}</span>}
              </div>
              <p class="resume">{p.data.resume}</p>
              <p class="meta">{[p.data.annee, ...p.data.stack].join(' · ')}</p>
            </div>
            {p.data.lien && (
              <a class="externe" href={p.data.lien} rel="noopener">
                {p.data.lienLabel ?? new URL(p.data.lien).hostname} ↗
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" id="outils">
    <p class="eyebrow"><span class="sigil">~</span> cat outils.txt</p>
    <p class="intro">
      Ce que j'utilise vraiment, classé par ce que j'en fais et pas par ce qui rend
      bien sur un profil.
    </p>
    {
      outils.map((groupe) => (
        <div class="groupe">
          <h2>{groupe.categorie}</h2>
          <ul>
            {groupe.outils.map((o) => (
              <li>
                <span class="nom">{o.nom}</span>
                <span class="note">{o.note}</span>
                <span class="niveau" data-niveau={o.niveau}>
                  {o.niveau}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="section contact" id="contact">
    <p class="eyebrow"><span class="sigil">~</span> mail -s "bonjour"</p>
    <p class="intro">
      Une mission, une question sur les ACM, une idée à casser. Je lis tout, je réponds
      sous 48 h.
    </p>
    <ContactForm />
  </section>
</Base>

<style>
  .hero h1 {
    font-size: 1.625rem;
    line-height: 1.25;
    max-width: 30ch;
  }
  .pitch {
    color: var(--muted);
    max-width: 56ch;
    margin: 0.9rem 0 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
  }
  .tags li {
    font-size: 0.6875rem;
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.15rem 0.55rem;
  }

  .liste {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .projet {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.15rem;
    margin-bottom: 1.15rem;
    border-bottom: 1px solid var(--rule);
  }
  .projet:last-child {
    border-bottom: 0;
    padding-bottom: 0;
    margin-bottom: 0;
  }
  .corps {
    min-width: 0;
  }
  .titre-ligne {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .titre-ligne a {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
  }
  .titre-ligne a:hover {
    border-bottom-color: var(--accent);
  }
  .badge {
    font-size: 0.625rem;
    background: var(--accent-bg);
    color: var(--accent-text);
    border-radius: 3px;
    padding: 0.1rem 0.45rem;
  }
  .resume {
    color: var(--muted);
    font-size: 0.8125rem;
    margin: 0.4rem 0 0;
    max-width: 58ch;
  }
  .meta {
    font-size: 0.6875rem;
    color: var(--faint);
    margin: 0.5rem 0 0;
  }
  .externe {
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .intro {
    color: var(--muted);
    max-width: 58ch;
    margin: 0 0 1.75rem;
  }
  .groupe {
    margin-bottom: 1.5rem;
  }
  .groupe h2 {
    font-size: 0.6875rem;
    color: var(--faint);
    font-weight: 400;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule);
  }
  .groupe ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .groupe li {
    display: grid;
    grid-template-columns: 11rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.4rem 0;
    font-size: 0.8125rem;
  }
  .nom {
    font-weight: 500;
  }
  .note {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .niveau {
    font-size: 0.625rem;
    color: var(--faint);
    white-space: nowrap;
  }
  .niveau[data-niveau='quotidien'] {
    color: var(--accent);
  }

  @media (max-width: 34rem) {
    .projet {
      flex-direction: column;
      gap: 0.5rem;
    }
    .groupe li {
      grid-template-columns: 1fr auto;
    }
    .note {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>
