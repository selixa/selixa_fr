---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { blocs } from '../data/outils';

const projets = (await getCollection('projets', ({ data }) => !data.brouillon)).sort(
  (a, b) => a.data.ordre - b.data.ordre
);
---

<Base titre="selixa.fr — Alexis">
  <section class="section hero">
    <p class="eyebrow"><span class="sigil">~</span> whoami</p>
    <h1>Je conçois et je livre des applications métier, seul, de la base de données à l'écran.</h1>
    <p class="pitch">
      Développeur produit à Lyon, spécialisé no-code et low-code. Je modélise le schéma
      PostgreSQL, j'écris les fonctions serveur, je construis l'interface et je déploie.
      Avant ça : Apple Retail, puis customer success — et une vingtaine de saisons en
      direction d'accueils collectifs de mineurs, ce qui explique pour qui je conçois.
    </p>
    <ul class="tags">
      <li>PostgreSQL</li>
      <li>Supabase</li>
      <li>WeWeb</li>
      <li>FlutterFlow</li>
      <li>Deno</li>
      <li>Cloudflare</li>
    </ul>
  </section>

  <section class="section" id="projets">
    <p class="eyebrow"><span class="sigil">~</span> ls projets/</p>
    <ul class="liste">
      {
        projets.map((p) => (
          <li class="projet">
            <div class="corps">
              <div class="titre-ligne">
                <a href={`/projets/${p.id}/`}>{p.data.titre}</a>
                {p.data.statut && <span class="badge">{p.data.statut}</span>}
              </div>
              <p class="resume">{p.data.resume}</p>
              <p class="meta">{[p.data.annee, ...p.data.stack].join(' · ')}</p>
            </div>
            {p.data.lien && (
              <a class="externe" href={p.data.lien} rel="noopener">
                {p.data.lienLabel ?? new URL(p.data.lien).hostname} ↗
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" id="outils">
    <p class="eyebrow"><span class="sigil">~</span> cat outils.txt</p>
    {
      blocs.map((bloc) => (
        <div class="bloc">
          <div class="bloc-tete">
            <h2>{bloc.titre}</h2>
            <span class="compte">{bloc.outils.length}</span>
          </div>
          <p class="intro">{bloc.intro}</p>
          <ul class="catalogue">
            {bloc.outils.map((o) => {
              const cible = o.lienAffilie ?? o.lien;
              const Balise = cible ? 'a' : 'div';
              return (
                <li>
                  <Balise
                    class="carte"
                    href={cible}
                    rel={
                      cible
                        ? o.lienAffilie
                          ? 'noopener sponsored nofollow'
                          : 'noopener'
                        : undefined
                    }
                  >
                    <span class="tete">
                      {o.logo ? (
                        <img
                          class="logo"
                          src={`/logos/${o.logo}.svg`}
                          alt=""
                          width="16"
                          height="16"
                          loading="lazy"
                        />
                      ) : (
                        <span class="monogramme" aria-hidden="true">
                          {o.nom.slice(0, 2)}
                        </span>
                      )}
                      <span class="nom">{o.nom}</span>
                      {o.lienAffilie && <span class="aff">aff.</span>}
                    </span>
                    <span class="cat">{o.categorie}</span>
                    <span class="note">{o.note}</span>
                  </Balise>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
    <p class="mention">
      Quelques liens de cette page sont des liens de parrainage, signalés par la mention
      « aff. ». Ils ne changent rien à ce qui est écrit au-dessus — je n'y ai mis que des
      outils que j'utilise pour de vrai.
    </p>
  </section>

  <section class="section contact" id="contact">
    <p class="eyebrow"><span class="sigil">~</span> mail -s "bonjour"</p>
    <p class="intro intro-seule">
      Une mission, une question sur un stack, une idée à casser. Je lis tout, je réponds
      sous 48 h.
    </p>
    <ContactForm />
  </section>
</Base>

<style>
  .hero h1 {
    font-size: 1.5rem;
    line-height: 1.3;
    max-width: 34ch;
  }
  .pitch {
    color: var(--muted);
    max-width: 60ch;
    margin: 0.9rem 0 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
  }
  .tags li {
    font-size: 0.6875rem;
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.15rem 0.55rem;
  }

  .liste {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .projet {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.15rem;
    margin-bottom: 1.15rem;
    border-bottom: 1px solid var(--rule);
  }
  .projet:last-child {
    border-bottom: 0;
    padding-bottom: 0;
    margin-bottom: 0;
  }
  .corps {
    min-width: 0;
  }
  .titre-ligne {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .titre-ligne a {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
  }
  .titre-ligne a:hover {
    border-bottom-color: var(--accent);
  }
  .badge {
    font-size: 0.625rem;
    background: var(--accent-bg);
    color: var(--accent-text);
    border-radius: 3px;
    padding: 0.1rem 0.45rem;
  }
  .resume {
    color: var(--muted);
    font-size: 0.8125rem;
    margin: 0.4rem 0 0;
    max-width: 60ch;
  }
  .meta {
    font-size: 0.6875rem;
    color: var(--faint);
    margin: 0.5rem 0 0;
  }
  .externe {
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .bloc + .bloc {
    margin-top: 2.5rem;
  }
  .bloc-tete {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule-strong);
  }
  .bloc-tete h2 {
    font-size: 0.9375rem;
  }
  .compte {
    font-size: 0.625rem;
    color: var(--faint);
  }
  .intro {
    color: var(--muted);
    font-size: 0.8125rem;
    max-width: 62ch;
    margin: 0.8rem 0 1.25rem;
  }
  .intro-seule {
    margin-bottom: 1.75rem;
  }

  .catalogue {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr));
    gap: 0.6rem;
  }
  .catalogue li {
    display: flex;
  }
  .carte {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.6rem 0.7rem 0.7rem;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  a.carte:hover {
    border-color: var(--rule-strong);
    border-bottom-color: var(--rule-strong);
  }
  a.carte:hover .logo,
  a.carte:hover .monogramme {
    opacity: 1;
    color: var(--accent);
  }
  .tete {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .logo {
    width: 0.875rem;
    height: 0.875rem;
    flex: none;
    opacity: 0.55;
    filter: grayscale(1);
  }
  html[data-theme='dark'] .logo {
    filter: grayscale(1) invert(1);
  }
  .monogramme {
    font-size: 0.5rem;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--faint);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    padding: 0.16rem 0.14rem;
    flex: none;
    opacity: 0.7;
  }
  .aff {
    font-size: 0.5rem;
    color: var(--faint);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0 0.2rem;
  }
  .cat {
    font-size: 0.5625rem;
    color: var(--faint);
    letter-spacing: 0.04em;
    margin-top: 0.1rem;
  }
  .nom {
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .note {
    font-size: 0.6875rem;
    color: var(--muted);
    line-height: 1.55;
    margin-top: 0.2rem;
  }
  .mention {
    font-size: 0.625rem;
    color: var(--faint);
    line-height: 1.6;
    max-width: 62ch;
    margin: 2rem 0 0;
  }

  @media (max-width: 34rem) {
    .projet {
      flex-direction: column;
      gap: 0.5rem;
    }
    .catalogue {
      grid-template-columns: 1fr;
    }
  }
</style>
