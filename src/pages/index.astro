---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { blocs } from '../data/outils';

const projets = (await getCollection('projets', ({ data }) => !data.brouillon)).sort(
  (a, b) => a.data.ordre - b.data.ordre
);
---

<Base titre="selixa.fr — Alexis">
  <section class="section hero">
    <p class="eyebrow"><span class="sigil">~</span> whoami</p>
    <h1>Je conçois et je livre des applications métier, seul, de la base de données à l'écran.</h1>
    <p class="pitch">
      Développeur produit à Lyon, spécialisé no-code et low-code. Je modélise le schéma
      PostgreSQL, j'écris les fonctions serveur, je construis l'interface et je déploie.
      Avant ça : Apple Retail, puis customer success — et une vingtaine de saisons en
      direction d'accueils collectifs de mineurs, ce qui explique pour qui je conçois.
    </p>
    <ul class="tags">
      <li>PostgreSQL</li>
      <li>Supabase</li>
      <li>WeWeb</li>
      <li>FlutterFlow</li>
      <li>Deno</li>
      <li>Cloudflare</li>
    </ul>
  </section>

  <section class="section" id="projets">
    <p class="eyebrow"><span class="sigil">~</span> ls projets/</p>
    <ul class="liste">
      {
        projets.map((p) => (
          <li class="projet">
            <div class="corps">
              <div class="titre-ligne">
                <a href={`/projets/${p.id}/`}>{p.data.titre}</a>
                {p.data.statut && <span class="badge">{p.data.statut}</span>}
              </div>
              <p class="resume">{p.data.resume}</p>
              <p class="meta">{[p.data.annee, ...p.data.stack].join(' · ')}</p>
            </div>
            {p.data.lien && (
              <a class="externe" href={p.data.lien} rel="noopener">
                {p.data.lienLabel ?? new URL(p.data.lien).hostname} ↗
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" id="outils">
    <p class="eyebrow"><span class="sigil">~</span> cat outils.txt</p>
    {
      blocs.map((bloc) => (
        <div class="bloc">
          <div class="bloc-tete">
            <h2>{bloc.titre}</h2>
            <span class="compte">{bloc.outils.length}</span>
          </div>
          <p class="intro">{bloc.intro}</p>
          <ul class="catalogue">
            {bloc.outils.map((o) => (
              <li class="carte">
                <span class="cat">{o.categorie}</span>
                <span class="nom">{o.nom}</span>
                <span class="note">{o.note}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="section contact" id="contact">
    <p class="eyebrow"><span class="sigil">~</span> mail -s "bonjour"</p>
    <p class="intro intro-seule">
      Une mission, une question sur un stack, une idée à casser. Je lis tout, je réponds
      sous 48 h.
    </p>
    <ContactForm />
  </section>
</Base>

<style>
  .hero h1 {
    font-size: 1.5rem;
    line-height: 1.3;
    max-width: 34ch;
  }
  .pitch {
    color: var(--muted);
    max-width: 60ch;
    margin: 0.9rem 0 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
  }
  .tags li {
    font-size: 0.6875rem;
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.15rem 0.55rem;
  }

  .liste {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .projet {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.15rem;
    margin-bottom: 1.15rem;
    border-bottom: 1px solid var(--rule);
  }
  .projet:last-child {
    border-bottom: 0;
    padding-bottom: 0;
    margin-bottom: 0;
  }
  .corps {
    min-width: 0;
  }
  .titre-ligne {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .titre-ligne a {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
  }
  .titre-ligne a:hover {
    border-bottom-color: var(--accent);
  }
  .badge {
    font-size: 0.625rem;
    background: var(--accent-bg);
    color: var(--accent-text);
    border-radius: 3px;
    padding: 0.1rem 0.45rem;
  }
  .resume {
    color: var(--muted);
    font-size: 0.8125rem;
    margin: 0.4rem 0 0;
    max-width: 60ch;
  }
  .meta {
    font-size: 0.6875rem;
    color: var(--faint);
    margin: 0.5rem 0 0;
  }
  .externe {
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .bloc + .bloc {
    margin-top: 2.5rem;
  }
  .bloc-tete {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule-strong);
  }
  .bloc-tete h2 {
    font-size: 0.9375rem;
  }
  .compte {
    font-size: 0.625rem;
    color: var(--faint);
  }
  .intro {
    color: var(--muted);
    font-size: 0.8125rem;
    max-width: 62ch;
    margin: 0.8rem 0 1.25rem;
  }
  .intro-seule {
    margin-bottom: 1.75rem;
  }

  .catalogue {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr));
    gap: 0.6rem;
  }
  .carte {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.6rem 0.7rem 0.7rem;
    background: var(--surface);
  }
  .carte:hover {
    border-color: var(--rule-strong);
  }
  .cat {
    font-size: 0.5625rem;
    color: var(--faint);
    letter-spacing: 0.04em;
  }
  .nom {
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .note {
    font-size: 0.6875rem;
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 34rem) {
    .projet {
      flex-direction: column;
      gap: 0.5rem;
    }
    .catalogue {
      grid-template-columns: 1fr;
    }
  }
</style>
