---
import Icone from './Icone.astro';
---

<button id="theme-toggle" type="button" aria-label="Basculer entre thème clair et sombre">
  <span data-when="light"><Icone nom="lune" taille={20} /></span>
  <span data-when="dark"><Icone nom="soleil" taille={20} /></span>
</button>

<style>
  button {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--sx-radius-pill);
    border: 0;
    background: transparent;
    color: var(--sx-text);
    box-shadow: inset 0 0 0 2px var(--sx-border);
    cursor: pointer;
    transition: box-shadow var(--sx-dur) var(--sx-ease), transform var(--sx-dur) var(--sx-ease);
  }
  button:hover {
    box-shadow: inset 0 0 0 2px var(--sx-ring);
    transform: rotate(-12deg);
  }
  [data-when] {
    display: none;
  }
  :global(html[data-theme='light']) [data-when='light'],
  :global(html[data-theme='dark']) [data-when='dark'] {
    display: contents;
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
