---
// Icônes au trait 2 px, coins arrondis, couleur du texte (règle du design system).
interface Props {
  nom: 'feuille' | 'puce' | 'ouvert' | 'code' | 'fleche' | 'externe' | 'soleil' | 'lune';
  taille?: number;
}
const { nom, taille = 24 } = Astro.props;
---

<svg
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={['icone', nom === 'fleche' && 'fleche']}
>
  {nom === 'feuille' && (
    <>
      <path d="M5 21c0-9 6-15 15-16-1 9-7 15-15 16z" />
      <path d="M5 21l8-8" />
    </>
  )}
  {nom === 'puce' && (
    <>
      <rect x="6" y="6" width="12" height="12" rx="2" />
      <path d="M10 10h4v4h-4zM9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4" />
    </>
  )}
  {nom === 'ouvert' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" />
    </>
  )}
  {nom === 'code' && <path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16" />}
  {nom === 'fleche' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {nom === 'externe' && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
  {nom === 'soleil' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </>
  )}
  {nom === 'lune' && <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />}
</svg>
