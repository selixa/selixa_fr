---
---

<form id="contact-form" novalidate>
  <div class="duo">
    <div class="champ">
      <label for="nom">Nom</label>
      <input id="nom" name="nom" type="text" required autocomplete="name" />
    </div>
    <div class="champ">
      <label for="email">E-mail</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="prenom@exemple.fr"
      />
    </div>
  </div>
  <div class="champ">
    <label for="message">Message</label>
    <textarea id="message" name="message" rows="5" required></textarea>
  </div>

  <div class="piege" aria-hidden="true">
    <label for="societe">société</label>
    <input id="societe" name="societe" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="pied">
    <button class="sx-btn" type="submit">Envoyer le message</button>
    <p id="statut" role="status"></p>
  </div>
</form>

<style>
  form {
    display: grid;
    gap: var(--sx-space-5);
  }
  .duo {
    display: grid;
    gap: var(--sx-space-5);
  }
  @media (min-width: 640px) {
    .duo {
      grid-template-columns: 1fr 1fr;
    }
  }
  .champ {
    display: grid;
    gap: var(--sx-space-2);
  }
  label {
    font-size: var(--sx-fs-sm);
    font-weight: 500;
  }
  input,
  textarea {
    font: inherit;
    color: var(--sx-text);
    background: var(--sx-surface);
    border: 1px solid var(--sx-border);
    border-radius: var(--sx-radius-md);
    padding: var(--sx-space-3) var(--sx-space-4);
    min-height: 48px;
    width: 100%;
    resize: vertical;
    transition: border-color var(--sx-dur) var(--sx-ease), box-shadow var(--sx-dur) var(--sx-ease);
  }
  input:hover,
  textarea:hover {
    border-color: var(--sx-ring);
  }
  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--sx-focus);
    box-shadow: 0 0 0 4px var(--sx-glow);
    outline: none;
  }
  input::placeholder {
    color: var(--sx-text-muted);
  }
  .piege {
    position: absolute;
    left: -9999px;
  }
  .pied {
    display: flex;
    align-items: center;
    gap: var(--sx-space-5);
    flex-wrap: wrap;
  }
  button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
  #statut {
    margin: 0;
    font-size: var(--sx-fs-sm);
    color: var(--sx-text-muted);
  }
  #statut[data-etat='erreur'] {
    color: var(--sx-text);
    font-weight: 500;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statut = document.getElementById('statut');
  const bouton = form?.querySelector('button') as HTMLButtonElement | null;

  const dire = (texte: string, etat = '') => {
    if (!statut) return;
    statut.textContent = texte;
    statut.dataset.etat = etat;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form));

    if (!data.nom || !data.email || !data.message) {
      dire('Il manque un champ.', 'erreur');
      return;
    }

    bouton && (bouton.disabled = true);
    dire('Envoi…');

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      dire('Message envoyé. Nous vous répondons sous 48 h.');
    } catch {
      dire('L\u2019envoi a échoué. Écrivez directement à alexis@thomas.bz.', 'erreur');
    } finally {
      bouton && (bouton.disabled = false);
    }
  });
</script>
