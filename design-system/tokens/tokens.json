{
  "name": "Selixacorp",
  "version": "1.1.0",
  "color": {
    "brand": {
      "indigo": "#1E2160",
      "indigoDeep": "#14163A",
      "blue": "#2B3FD6",
      "coral": "#FF8A5B"
    },
    "light": {
      "bg": "#F7F7FB",
      "surface": "#FFFFFF",
      "text": "#1E2160",
      "textMuted": "#5A5E8A",
      "border": "#E2E4F0",
      "link": "#2B3FD6",
      "primary": "#1E2160",
      "onPrimary": "#FFFFFF"
    },
    "dark": {
      "bg": "#14163A",
      "surface": "#1E2160",
      "text": "#F7F7FB",
      "textMuted": "#B4B8E0",
      "border": "#343A8A",
      "link": "#A9B4FF",
      "primary": "#FFFFFF",
      "onPrimary": "#14163A"
    },
    "notes": "Le corail (#FF8A5B) est décoratif : contraste insuffisant pour du texte ou un fond de bouton avec texte blanc."
  },
  "font": {
    "family": "Space Grotesk",
    "fallback": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    },
    "tracking": {
      "display": "-0.03em",
      "heading": "-0.02em"
    }
  },
  "space": {
    "unit": 4,
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      96,
      128
    ]
  },
  "radius": {
    "sm": 8,
    "md": 16,
    "lg": 24,
    "pill": 999
  },
  "layout": {
    "container": 1120,
    "gutterMobile": 16,
    "gutterDesktop": 32
  },
  "futuriste": {
    "notes": "Extension assumée (v1.1) : halos, trame, verre. Voir README > Écarts assumés.",
    "light": {
      "indigoNight": "#0D0F2B",
      "glow": "rgb(43 63 214 / 20%)",
      "glow2": "rgb(255 138 91 / 14%)",
      "gridLine": "rgb(30 33 96 / 7%)",
      "glassBg": "rgb(247 247 251 / 72%)",
      "ring": "rgb(43 63 214 / 45%)",
      "onBand": "#F7F7FB",
      "onBandMuted": "#B4B8E0",
      "bandBorder": "#343A8A",
      "bandGridLine": "rgb(169 180 255 / 9%)",
      "bandSurface": "rgb(30 33 96 / 55%)"
    },
    "dark": {
      "glow": "rgb(110 128 255 / 26%)",
      "glow2": "rgb(255 138 91 / 12%)",
      "gridLine": "rgb(169 180 255 / 8%)",
      "glassBg": "rgb(20 22 58 / 70%)",
      "ring": "rgb(169 180 255 / 55%)"
    },
    "glassBlur": "14px",
    "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)",
    "duration": "420ms"
  }
}